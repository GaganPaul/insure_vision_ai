# InsureVisionAI Backend Configuration
# Copy this file to .env and configure your environment variables

# Application Settings
APP_NAME=InsureVisionAI
APP_ENV=development
API_V1_PREFIX=/api/v1

# Security & JWT Configuration
# IMPORTANT: Generate a secure 32+ character key for production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=insure_vision_ai_super_secret_jwt_key_2026_demo_secure_key_123456
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Server Host & Port
HOST=127.0.0.1
PORT=8000
